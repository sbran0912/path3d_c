# clangd-Konfiguration für path3d
# Entspricht den Compile-Flags aus dem Makefile (CFLAGS): -std=c17 -Ilib3d
CompileFlags:
  Add:
    - -std=c17
    - -Ilib3d
---
# Ohne compile_commands.json parst clangd Header per Fallback als
# Objective-C++ (permissivste Sprache), was mit -std=c17 kollidiert.
# Header daher explizit als C-Header behandeln.
If:
  PathMatch: .*\.h$
CompileFlags:
  Add:
    - -x
    - c-header
